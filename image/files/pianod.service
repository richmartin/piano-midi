[Unit]
Description=Piano player and loop station (pianod)
After=local-fs.target
RequiresMountsFor=/var/lib/piano
# No network dependency on purpose: the library mirror is local, so the piano plays without one.

[Service]
Type=notify
NotifyAccess=main
ExecStart=/opt/piano/pianod/bin/pianod
RuntimeDirectory=piano
Restart=always
RestartSec=3
# pianod pings systemd every second; if it hangs, systemd kills and restarts it.
WatchdogSec=30
Environment=PYTHONUNBUFFERED=1
# Compiled modules on the data partition: on the read-only root they'd be compiled again at
# every boot.
Environment=PYTHONPYCACHEPREFIX=/var/lib/piano/pycache
# The DKW10's key sensors report its own playback on MIDI OUT (docs/design.md); the echo gate
# drops it. Timing and velocity per key come from /var/lib/piano/calibration.json.
Environment=PIANO_ECHO_MS=250
# Warnings and errors to murdoch's rsyslog too (LAN only; it accepts only the Pi's address):
# ssh murdoch tail -f /var/log/pianopi/pianod.log
Environment=PIANO_SYSLOG=192.168.0.51:1514
# Quiet hours: Saxy's Band (POST /api/events) takes dry runs only (live.py).
Environment=PIANO_CURFEW=22:00-07:00
# The companion (companion.py) asks Zeus, the fleet's AI gateway, never a model directly. Its
# token is machine-local and never in this repo: ZEUS_TOKEN=... in /var/lib/piano/zeus.env
# (root, 0600), matched by piano:<token> in Zeus's ZEUS_TOKENS. Without it the companion says so.
Environment=ZEUS_URL=http://192.168.0.51:8390
EnvironmentFile=-/var/lib/piano/zeus.env
# Scores (pipeline.py): sheet music goes to Saxy's pipeline, which reads and performs it. Its token is
# Saxy's PIANO_SCORES_TOKEN, machine-local like Zeus's: SAXY_TOKEN=... in /var/lib/piano/saxy.env.
Environment=SAXY_URL=http://192.168.0.51:8570
EnvironmentFile=-/var/lib/piano/saxy.env

[Install]
WantedBy=multi-user.target
